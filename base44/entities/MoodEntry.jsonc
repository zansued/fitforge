{
  "name": "MoodEntry",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do registro"
    },
    "mood": {
      "type": "string",
      "enum": [
        "muito_feliz",
        "feliz",
        "neutro",
        "triste",
        "muito_triste",
        "ansioso",
        "estressado",
        "calmo",
        "energizado",
        "cansado"
      ],
      "description": "Estado emocional principal"
    },
    "intensity": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "description": "Intensidade do sentimento (1-10)"
    },
    "notes": {
      "type": "string",
      "description": "Pensamentos e observa\u00e7\u00f5es"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gatilhos ou eventos relacionados"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Atividades realizadas no dia"
    },
    "sleep_hours": {
      "type": "number",
      "description": "Horas de sono"
    },
    "ai_insights": {
      "type": "string",
      "description": "Insights gerados pela IA"
    }
  },
  "required": [
    "date",
    "mood"
  ],
  "rls": {
    "create": {},
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}